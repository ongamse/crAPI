deploy/vagrant/*.log
deploy/vagrant/.vagrant
.secrets
.vscode/
*.local
services/chatbot/db
services/certs/
# TLS private keys are generated locally (services/gencert.sh) or mounted at deploy time; never commit them
services/*/certs/server.key
services/identity/src/main/resources/certs/server.key
services/gateway-service/server.key
docker-compose.local.yml
# JWT signing keys (JWKS with private components) are supplied at deploy time; never commit them
deploy/*/keys/jwks.json
services/identity/jwks.json
