IDENTITY_SERVER_PORT=8080
COMMUNITY_SERVER_PORT=8087
WORKSHOP_SERVER_PORT=8000
CHATBOT_SERVER_PORT=5002
ENABLE_SHELL_INJECTION=false
ENABLE_LOG4J=false
LISTEN_IP="127.0.0.1"
# TLS key material is not shipped. To enable TLS set TLS_ENABLED=true and put server.crt,
# server.key and (for crapi-identity) server.p12 in ./certs (or point TLS_CERTS_DIR at the
# directory), and set TLS_KEYSTORE_PASSWORD / TLS_KEY_PASSWORD. See services/gencert.sh.
TLS_ENABLED=false
VERSION=latest
# Comma separated browser origins allowed cross-origin access to the identity and workshop APIs
# (never "*"). The bundled web UI uses same-origin proxying; add other front-ends here.
CORS_ALLOWED_ORIGINS=http://localhost:8888,https://localhost:8443,http://127.0.0.1:8888,https://127.0.0.1:8443
LOG_LEVEL=INFO
# Comma separated Host header allowlist for crapi-workshop (never "*"; wildcards are ignored).
# Add any extra hostname the workshop service is reached by.
WORKSHOP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0,crapi-workshop

# Credentials are not shipped. Set these (here, or in your shell) before `docker compose up`.
# Do not commit real values.
DB_PASSWORD=
MONGO_DB_PASSWORD=
WORKSHOP_SECRET_KEY=
API_GATEWAY_PASSWORD=
# Password the chatbot uses to log in as its API user (admin@example.com); must match that
# account's password. Chatbot API calls fail until it is set.
CHATBOT_API_PASSWORD=
# Optional: password for the seeded mechanic accounts. A random one is generated when empty.
MECHANIC_PASSWORD=

# Only needed when TLS_ENABLED=true (password used when building server.p12).
TLS_KEYSTORE_PASSWORD=
TLS_KEY_PASSWORD=
