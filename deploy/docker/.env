IDENTITY_SERVER_PORT=8080
COMMUNITY_SERVER_PORT=8087
WORKSHOP_SERVER_PORT=8000
CHATBOT_SERVER_PORT=5002
ENABLE_SHELL_INJECTION=false
ENABLE_LOG4J=false
LISTEN_IP="127.0.0.1"
TLS_ENABLED=true
VERSION=latest
LOG_LEVEL=INFO
# Credentials are NOT stored here. Export these before `docker compose up`:
#   DB_PASSWORD, MONGO_DB_PASSWORD, SECRET_KEY, API_GATEWAY_PASSWORD
# With TLS_ENABLED=true also export TLS_KEYSTORE_PASSWORD and TLS_KEY_PASSWORD
# (the passwords of the identity keystore you mount/use).
