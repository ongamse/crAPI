# Secrets required by docker-compose.yml. Copy the needed lines into .env (or
# export them) and set strong, unique values. Do not commit real values.
DB_PASSWORD=
MONGO_DB_PASSWORD=
JWT_SECRET=
SECRET_KEY=
# Password used by the identity/workshop services to call the API gateway.
API_GATEWAY_PASSWORD=
# Password for the pre-populated mechanic accounts (random when empty).
MECHANIC_SEED_PASSWORD=
