# Credentials required by docker-compose.yml. Copy the variables below into the
# .env file next to docker-compose.yml (or export them in your shell) and give
# each one a strong value of your own. They are intentionally empty here and
# docker compose refuses to start until they are set. Never commit real values.
#
# Example: DB_PASSWORD=$(openssl rand -hex 16)

# Password for the PostgreSQL "admin" user (postgresdb and the services that use it)
DB_PASSWORD=
# Password for the MongoDB "admin" user (mongodb, mailhog and the services that use it)
MONGO_DB_PASSWORD=
# Django SECRET_KEY of the workshop service
SECRET_KEY=
# Basic-auth password shared by identity, workshop and the vendor API gateway
# (the gateway user name is "vendorcrapi")
API_GATEWAY_PASSWORD=
# Optional: password for the external SMTP server used by the identity service (may stay empty)
SMTP_PASS=
# Optional: password of the seeded demo admin account (admin@example.com), shared by the identity
# service (seed data) and the chatbot (its API login). Leave empty to keep the documented demo
# password from chatbot/retrieval/instructions/users.md.
ADMIN_PASSWORD=
