# Secrets required by docker-compose.yml. Copy the needed lines into .env (or
# export them) and set strong, unique values. Do not commit real values.
DB_PASSWORD=
MONGO_DB_PASSWORD=
JWT_SECRET=
# RSA signing key for identity (JWKS json, RS256, single key with private
# parameters), base64 encoded: JWKS=$(openssl base64 -in jwks.json -A).
# Alternatively place the file at deploy/docker/keys/jwks.json (git-ignored).
# Never commit it.
JWKS=
SECRET_KEY=
# Password used by the identity/workshop services to call the API gateway.
API_GATEWAY_PASSWORD=
# Password for the pre-populated mechanic accounts (random when empty).
MECHANIC_SEED_PASSWORD=
# Optional TLS (TLS_ENABLED=true). The private key and certificate are never
# stored in git: run services/gencert.sh (or supply your own server.crt,
# server.key and identity's server.p12) and point TLS_CERTS_DIR at that folder
# (default: services/certs, which is git-ignored).
TLS_ENABLED=false
TLS_CERTS_DIR=
TLS_KEYSTORE_PASSWORD=
TLS_KEY_PASSWORD=
