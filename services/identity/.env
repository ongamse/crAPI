# Credentials are not stored here. Export DB_PASSWORD and API_GATEWAY_PASSWORD in your
# environment (or secrets manager) before sourcing this file.
export SMTP_AUTH=true
export SMTP_STARTTLS=true
export MAILHOG_DOMAIN=example.com
export SMTP_EMAIL=user@example.com
export MAILHOG_PORT=1025
export DB_PORT=5432
export DB_USER=admin
export LANG=C.UTF-8
export SMTP_PASS=xxxxxxxxxxxxxx
export MAILHOG_HOST=127.0.0.1
export SMTP_PORT=587
export ENABLE_LOG4J=false
export DB_HOST=127.0.0.1
export JAVA_TOOL_OPTIONS=-Xmx2048m
export DB_NAME=crapi
export SERVER_PORT=8989
export SMTP_FROM=no-reply@example.com
export ENABLE_SHELL_INJECTION=false
export SMTP_HOST=smtp.example.com
export JWT_EXPIRATION=604800000
export API_GATEWAY_URL=https://api.mypremiumdealership.com
export TLS_ENABLED=false
export TLS_KEYSTORE_TYPE=PKCS12
# When TLS_ENABLED=true, provide a keystore at runtime and export its passwords
# (TLS_KEYSTORE_PASSWORD / TLS_KEY_PASSWORD) from your environment or secrets manager.
export TLS_KEYSTORE=file:./certs/server.p12
export TLS_KEY_ALIAS=identity
# Provide the RSA signing key (JWKS) at runtime; it is not stored in the repo.
[ -f ./jwks.json ] && export JWKS=$(openssl base64 -in ./jwks.json -A)
